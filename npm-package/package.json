{
    "name": "snowballr-api",
    "version": "0.17.0",
    "description": "API for the SnowballR Web Application.",
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "type": "module",
    "scripts": {
        "compile": "node scripts/compile.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/SE-UUlm/snowballr-api.git"
    },
    "keywords": [
        "api",
        "protobuf",
        "grpc"
    ],
    "author": "SnowballR",
    "license": "GPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/SE-UUlm/snowballr-api/issues"
    },
    "homepage": "https://github.com/SE-UUlm/snowballr-api#readme",
    "peerDependencies": {
        "@protobuf-ts/runtime": "^2.11.1",
        "@protobuf-ts/runtime-rpc": "^2.11.1"
    },
    "devDependencies": {
        "@protobuf-ts/plugin": "^2.11.1",
        "ts-protoc-gen": "^0.15.0"
    }
}
